# Macro file for example B1
# 
# Can be run in batch, without graphic
# or interactively: Idle> /control/execute run1.mac

# Initialize kernel

/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/process/em/verbose 0
/process/had/verbose 0

## detector properties ##
/setDetector/alphaPosition 4          #4cm away
#/setDetector/cf4Density 1.4 g/cm3     #liquid
/setDetector/cf4Density 0.002 g/cm3  #gas
/setDetector/cf4LY 1000 MeVLY

/run/initialize

/run/beamOn 10000
