# Macro file for example B1
# 
# Can be run in batch, without graphic
# or interactively: Idle> /control/execute run1.mac

# Initialize kernel
/run/initialize

/control/verbose 2
/run/verbose 2
/event/verbose 1
/tracking/verbose 1

# 
# Shoot something
#
/gun/particle gamma
/gun/energy 0.511 MeV
/gun/position 0 0 10 cm
/gun/direction 0 0 -1
#
/run/beamOn 1
