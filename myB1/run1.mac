# Macro file for example B1
# 
# Can be run in batch, without graphic
# or interactively: Idle> /control/execute run1.mac

# Initialize kernel
/run/initialize

/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

# 
# Shoot something
#
#/gun/particle gamma
#/gun/energy 0.511 MeV
#/gun/direction 0 0 -1
#
#/gun/position 0 0 2 cm


/run/beamOn 100
