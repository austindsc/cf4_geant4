# Macro file for example B1
# 
# Can be run in batch, without graphic
# or interactively: Idle> /control/execute run1.mac

# Initialize kernel

/control/verbose 2
/run/verbose 2
/event/verbose 2
/tracking/verbose 0

/run/initialize

# 
# Shoot something
#
#/gun/particle gamma
#/gun/energy 0.511 MeV
#/gun/direction 0 0 -1
#
#/gun/position 0 0 2 cm


/run/beamOn 10000
