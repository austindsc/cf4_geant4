# Macro file for the initialization of example B1
# in interactive session
#
# Set some default verbose
/control/verbose 0
/run/verbose 0

/setDetector/alphaPosition 4
/setDetector/cf4Density 1.4 g/cm3
/setDetector/cf4LY 0.1 keVLY

#/process/optical/processActivation Scintillation false
#/process/optical/processActivation Cerenkov false

#/process/optical/verbose 2
#/process/optical/scintillation/verbose 2


#/tracking/verbose 0

# Initialize kernel
/run/initialize

# Visualization setting
/control/execute ../myB1/myVis.mac
