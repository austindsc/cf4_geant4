// helper file to do optics of Gas CF4.
// Same scope as in DetectorMaterials::BuildMaterials()

// G4Material * mGasCF4
// G4MaterialPropertiesTable

G4MaterialPropertiesTable *mpt_liquidCF4 = new G4MaterialPropertiesTable();
mLiquidCF4->SetMaterialPropertiesTable(mpt_liquidCF4);

/////////// ------- Refractive Indexes ------- ///////////

// taken from literature with many different densities
// french paper (7, 5eV), other two from second paper
G4double liq_cf4_photonE[4] = {7*eV, 5*eV, 2*eV, 1*eV}; 
G4double liq_cf4_n[4] = {1.24, 1.225, 1.21, 1.2039};
mpt_liquidCF4->AddProperty("RINDEX", liq_cf4_photonE, liq_cf4_n, 4);

// scintillation here
// 5 bar data taken via excel from Morozov 2010
double temp_s_liq_spectra_wls[123] = {
  204.0427891,210.4696753,216.3717294,221.1564893,224.8794886,228.0647226,232.3221881,236.5809923,239.7561858,244.5529226,250.976462,257.4083685,263.8452952,270.2757673,276.6983505,283.1242804,289.5755508,295.4994072,300.3603793,305.2220687,310.6181287,316.5510693,323.0164442,329.4770378,335.9352409,342.3845987,348.8330003,355.2806848,361.7243052,368.1662522,374.6081992,381.0487118,387.4868338,393.9259121,400.3659466,406.8069373,413.2457766,419.6822252,426.1222597,432.5622942,439.0020896,445.4442757,452.4218364,458.321476,464.7615105,470.6650946,477.6341687,484.069422,490.5065878,496.9459051,503.3821146,509.8164117,516.2533384,522.6873965,529.1173904,535.5404517,541.9587318,548.3681666,553.6997999,557.9576957,561.6771091,564.8575619,568.038971,570.99968,573.3042652,575.3998642,577.4943875,579.2417958,581.1710091,583.8178803,585.9294964,588.0380046,590.1407755,592.240319,594.3380696,596.4361787,598.1839456,600.6457844,603.8228904,606.9976058,610.1785368,613.3661614,616.5537861,621.3541088,627.7747794,633.6963886,639.0930223,643.9539945,647.7401056,650.284181,652.1068932,654.2921397,656.4777448,659.1976487,663.5229594,667.3090705,670.0224003,672.2026265,674.3814184,676.5623618
};

G4double s_liq_cf4_photonE[123];
for(int i = 0; i < 123; i++){ s_liq_cf4_photonE[i] = 1240 * eV/temp_s_liq_spectra_wls[i]; }

G4double s_liq_cf4_spectrum_fast[123] = {
  0.003732246824,0.0124703641,0.01152167882,0.04760284532,0.07439882989,0.1022942509,0.1307421872,0.1580736181,0.1943428291,0.2204352604,0.231964641,0.2365158633,0.2368801906,0.2426276685,0.254954553,0.2644901741,0.2528919442,0.2337601721,0.2062802849,0.17820227,0.1518559571,0.1251478987,0.1017864877,0.08241259568,0.0650324632,0.05502924096,0.04582352252,0.03721593195,0.03199773256,0.02817516484,0.02435259712,0.02172628512,0.02109373263,0.01966367634,0.01743611624,0.01441105233,0.01318037199,0.01394345118,0.01171589108,0.009488330974,0.007460146826,0.003438203153,0.000310582548,0.00137559438,-0.000851965721,-0.003076657103,0.0008735686006,0.002633527547,0.002798478875,0.001169046631,0.002131501768,0.004688964524,0.005053291804,0.007810130512,0.01395636041,0.02588449293,0.04180014449,0.0650927063,0.09247821256,0.1205672721,0.1503538959,0.182236836,0.2133222723,0.2495128804,0.2960346053,0.3378920804,0.3806467473,0.4146307848,0.4461216667,0.475614964,0.5041142503,0.535205424,0.5710816206,0.6096493925,0.649712484,0.6894765117,0.7231614852,0.7578395136,0.792513717,0.8291816799,0.8606658681,0.8865675296,0.9124691911,0.9355709831,0.9494928751,0.9322352369,0.9054104217,0.8779305346,0.8520912678,0.8181839685,0.789364581,0.756456074,0.723248503,0.6918324469,0.6636974879,0.637858221,0.6119250036,0.5832033916,0.5556780353,0.5263582954
};

G4double *s_liq_cf4_spectrum_slow = s_liq_cf4_spectrum_fast;

mpt_liquidCF4->AddProperty("FASTCOMPONENT", s_liq_cf4_photonE, s_liq_cf4_spectrum_fast, 1);
mpt_liquidCF4->AddProperty("SLOWCOMPONENT", s_liq_cf4_photonE, s_liq_cf4_spectrum_slow, 1);

mpt_liquidCF4->AddConstProperty("SCINTILLATIONYIELD", cf4Liq_ly);
mpt_liquidCF4->AddConstProperty("RESOLUTIONSCALE", 1); 
mpt_liquidCF4->AddConstProperty("FASTTIMECONSTANT", 5*ns); 
mpt_liquidCF4->AddConstProperty("SLOWTIMECONSTANT", 20*ns); 
mpt_liquidCF4->AddConstProperty("YIELDRATIO", 0.5); // fast/total light

mLiquidCF4->GetIonisation()->SetBirksConstant(0.132 * mm/MeV); // guessed from other plastics

// HO::testHO();