// helper file to do optics of Gas CF4.
// Same scope as in DetectorMaterials::BuildMaterials()
// 
// G4Material * mGasCF4
// G4MaterialPropertiesTable

G4MaterialPropertiesTable *mpt_gascf4 = new G4MaterialPropertiesTable();
mGasCF4->SetMaterialPropertiesTable(mpt_gascf4);

/////////// ------- Refractive Indexes ------- ///////////

// refractive indexes taken from
G4double gas_cf4_photonE[2] = {1239.841939*eV/140, 1239.841939*eV/1200};
G4double gas_cf4_n[2] = {1.2, 1.1};
mpt_gascf4->AddProperty("RINDEX", gas_cf4_photonE, gas_cf4_n, 2);    //2 is for length of arrays

// scintillation here
// 1 bar data taken via excel from Morozov 2010
double temp_gasCF4_wavelengths[100] = {
  212.0508174,214.1700834,217.8757508,221.0327758,222.9512315,224.1618308,225.1952867,227.2901686,231.6339825,234.2028245,240.088001,244.9523917,248.2131687,250.9276938,253.6412627,260.6450004,268.0919552,270.2004635,272.2917594,274.3794695,276.4721998,278.568516,280.6626807,282.7568454,285.3850699,290.1841973,295.0335272,298.289523,301.0169573,303.2065069,305.9332241,309.1920886,311.915937,314.0983148,316.8161867,320.0707481,323.3205284,326.5736554,330.3693289,335.7635959,341.1564285,346.0198391,351.9474727,358.4032851,364.8485789,371.2881353,377.7245839,384.1684434,390.6146935,397.0480343,403.4873516,409.9379048,416.392761,422.8421189,429.2821534,435.7284034,442.1746535,448.614688,455.0578303,461.5009726,467.9398118,474.3819978,480.8253792,487.2661309,493.7116638,500.1579138,506.5931671,511.9567149,549.4821857,555.9076376,562.3249614,568.7389384,575.1624777,581.5884077,588.0136205,594.4213819,600.8303387,607.2605717,614.7665743,621.2006323,627.6320607,634.0783107,640.5233655,646.9452315,653.3936331,659.8542267,666.2801567,672.7213865,679.1850879,685.1213276,691.0527383,697.5032915,703.4320725,709.3592279,714.1552475,718.9433781,725.3824564,730.7685954,734.5566189,738.3464354
};

double s_gas_cf4_Spectrum_Fast[100] = {
  0.,0.05810737617,0.09935811728,0.1507799007,0.1912427004,0.2255286705,0.2584199652,0.3008755682,0.3467882641,0.3518785186,0.3650057756,0.3346748124,0.2995674324,0.2726373353,0.2465047419,0.2215454545,0.2743399198,0.3054310935,0.3508773358,0.3993142174,0.4435642039,0.4848235512,0.527877282,0.5709310129,0.6159756345,0.6400743063,0.622304028,0.5911841671,0.5534877686,0.5169904944,0.4798922237,0.4463798514,0.411674092,0.3811580965,0.351436736,0.3215131308,0.2955770447,0.2668496952,0.2330353903,0.208184397,0.1845296595,0.1550161376,0.1327342254,0.1173478525,0.1107340214,0.1089052132,0.1096682924,0.1042507171,0.09683938222,0.1001943488,0.09856491654,0.08756481454,0.07297594539,0.06297272315,0.06074516305,0.05333382818,0.04592249332,0.04369493322,0.03887548574,0.03405603826,0.03282535792,0.02880341424,0.02378459081,0.02095890285,0.01414569585,0.006734360985,0.008494319931,0.009263136553,0.03079430505,0.04072867804,0.05744183342,0.07694625213,0.08847563274,0.09801125383,0.1081450028,0.1328331962,0.1565245099,0.1624713639,0.166019969,0.1687768077,0.1737267819,0.166315447,0.1599009919,0.1728260042,0.1636202858,0.1442463937,0.1537820148,0.150557575,0.1285917956,0.09913234911,0.07370029687,0.06270019487,0.0394612781,0.01757811782,0.04426867697,0.07753864255,0.07610858625,0.05803637538,0.03060210089,0
};
G4double reversed_Intensity[100];
G4double s_gas_cf4_photonE[100];

// have to flip Intensity orders to match reversed order photonE
// order of things passed to MPT MUST start at lower photonE
for(int i = 0; i < 100; i++){
  s_gas_cf4_photonE[100-i-1] = CLHEP::h_Planck * CLHEP::c_light/ (temp_gasCF4_wavelengths[i] * nm);
  reversed_Intensity[100-i-1] = s_gas_cf4_Spectrum_Fast[i];
} // keep order is in ascending energy


G4double *s_gas_cf4_Spectrum_Slow = s_gas_cf4_Spectrum_Fast;

mpt_gascf4->AddProperty("SCINTILLATIONCOMPONENT1", s_gas_cf4_photonE, reversed_Intensity, 100);
mpt_gascf4->AddProperty("SCINTILLATIONCOMPONENT2", s_gas_cf4_photonE, reversed_Intensity, 100);

mpt_gascf4->AddConstProperty("SCINTILLATIONYIELD", cf4Gas_ly);
mpt_gascf4->AddConstProperty("RESOLUTIONSCALE", 2); 
mpt_gascf4->AddConstProperty("SCINTILLATIONTIMECONSTANT1", 5*ns); 
mpt_gascf4->AddConstProperty("SCINTILLATIONTIMECONSTANT2", 20*ns); 
mpt_gascf4->AddConstProperty("SCINTILLATIONRISETIME1", 1*ns);
mpt_gascf4->AddConstProperty("SCINTILLATIONRISETIME2", 1*ns);
mpt_gascf4->AddConstProperty("SCINTILLATIONYIELD1", 1); // fast/total light
mpt_gascf4->AddConstProperty("SCINTILLATIONYIELD2", 1); // fast/total light

mGasCF4->GetIonisation()->SetBirksConstant(0.0 * mm/MeV); // guessed from other plastics
// mGasCF4->GetIonisation()->SetBirksConstant(0.132 * mm/MeV); // guessed from other plastics