# Macro file for the initialization of example B1
# in interactive session

## Verbosities ##

/vis/verbose 0
/tracking/verbose 0
/event/verbose 0
/run/verbose 0

/run/numberOfThreads 1

/process/em/verbose 0
#/process/had/deex/verbose 2
/particle/verbose 0
/tracking/verbose 0

## detector properties ##
/setDetector/myVerbosity 1
#/setDetector/gammaSource Cs137 #default
#/setDetector/gammaSource Co60
#/setDetector/gammaSource isoCs137
#/setDetector/gammaSource isoCo60
#/setDetector/alphaHeight 4. #currently gamma and alpha source have same intensity (see primary generator constructor)
/setDetector/gammaHeight 4.

#/setMaterial/detectionMedium gCF4
/setMaterial/detectionMedium lCF4
#/setMaterial/mediumDensity 1.7 g/cm3
#/setMaterial/mediumLY 10. MeVLY      # these units are photons/MeV, keVLY also available
#/setMaterial/mediumTemp 69 kelvin    # not implemented yet
#/setMaterial/mediumPressure 1.2 bar  # not implemented yet

## process toggling ##
#/process/optical/processActivation Scintillation false
#/process/optical/processActivation Cerenkov false

#/process/optical/verbose 2
#/process/optical/scintillation/verbose 2

### Initialize kernel (build detector) ###
/run/initialize

### run myVis ###
/control/execute ../myB1/myVis.mac

