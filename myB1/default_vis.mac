# Macro file for the initialization of example B1
# in interactive session

## Verbosities ##

#/run/verbose 0
/vis/verbose 0
/tracking/verbose 0
/event/verbose 0
/run/verbose 0

/process/em/verbose 0
/process/had/verbose 0

## detector properties ##
/setDetector/myVerbosity 1
/setDetector/alphaPosition 2.5

/setMaterial/detectionMedium gCF4
#/setMaterial/mediumDensity 1.4 g/cm3
#/setMaterial/mediumLY 1000 MeVLY
#/setMaterial/mediumTemp 69 kelvin
#/setMaterial/mediumPressure 1.2 bar

## process toggling ##
#/process/optical/processActivation Scintillation false
#/process/optical/processActivation Cerenkov false

#/process/optical/verbose 2
#/process/optical/scintillation/verbose 2

### Initialize kernel (build detector) ###
/run/initialize

### run myVis ###
/control/execute ../myB1/myVis.mac

