# Macro file for the initialization of example B1
# in interactive session

## Verbosities ##

/vis/verbose 0
/tracking/verbose 0
/event/verbose 0
/run/verbose 0

/run/numberOfThreads 1

/process/em/verbose 0
#/process/had/deex/verbose 2
/particle/verbose 0
/tracking/verbose 0

### Material Properties ###
#/setMaterial/detectionMedium gCF4      # default is gas
#/setMaterial/detectionMedium gAr       # currently undefined
/setMaterial/detectionMedium lCF4       # see Optics/material for default LYs

/setMaterial/mediumDensity 1.6047 g/cm3 # takes precendece over density from SetTemp. default densities given in DetectorMaterials.cc
/setMaterial/mediumTemp 145 kelvin      # sets density based on saturation curve data (gas or liquid CF4)
/setMaterial/mediumPressure 10.2 bar    # sets material property
#/setMaterial/mediumLY 10. MeVLY        # these units are photons/MeV, keVLY also available

### detector configuration ###
/setDetector/myVerbosity 1              # 1 outputs event level data

/setDetector/useCollimator false        # default is true
/setDetector/gammaHeight 4.4            # this turns on detConst.gammaStatus
/setDetector/GammaThetaMax 90           # user-bias angle of non-iso gamma sources, default is 2degrees, see detectorconstruction()

#/setDetector/gammaSource Cs137         # default, see available in detectorconstruction header and primary generator
#/setDetector/gammaSource Co60
#/setDetector/gammaSource Co57
#/setDetector/gammaSource isoCs137
#/setDetector/gammaSource isoCo60
#/setDetector/gammaSource isoCo57

#/setDetector/alphaHeight 4.            # this sets alphaStatus to true
                                        # currently gamma and alpha source have same intensity (see primary generator constructor to change)

## process toggling ##
#/process/optical/processActivation Scintillation false
#/process/optical/processActivation Cerenkov false
#/process/optical/processActivation OpRayleigh false
#/process/optical/processActivation OpAbsorption false
#/process/optical/processActivation OpBoundary false

#/process/optical/verbose 2
#/process/optical/scintillation/verbose 2

### Initialize kernel (build detector) ###
/run/initialize

### run myVis ###
/control/execute ../myB1/myVis.mac

