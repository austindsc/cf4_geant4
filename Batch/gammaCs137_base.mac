/vis/verbose 0
/tracking/verbose 0
/event/verbose 0
/run/verbose 0

/particle/verbose 0
/tracking/verbose 0

/setMaterial/detectionMedium lCF4

/setMaterial/mediumTemp 128 kelvin
/setMaterial/mediumPressure 10.7 bar

/setMaterial/mediumLY 5 keVLY
/setMaterial/mediumLY_VisFraction 0.9

/setDetector/myVerbosity 1

/setDetector/useCollimator true
/setDetector/GammaThetaMax 1.5

/setDetector/gammaSource Cs137 

/setDetector/gammaHeight 2

/run/initialize
/analysis/setFileName ../Cs137_69

/run/beamOn 100000