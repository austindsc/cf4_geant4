/vis/verbose 0
/tracking/verbose 0
/event/verbose 0
/run/verbose 0

/particle/verbose 0
/tracking/verbose 0

/setMaterial/detectionMedium lCF4

/setMaterial/mediumTemp 128 kelvin
/setMaterial/mediumPressure 10.7 bar

/setMaterial/mediumLY 5 keVLY
/setMaterial/mediumLY_VisFraction 0.5

/setDetector/myVerbosity 0

/setDetector/useCollimator true
/setDetector/GammaThetaMax 1.5

/setDetector/gammaSource Co57 

/setDetector/gammaHeight 3

/run/initialize
/analysis/setFileName ../Co57_69

/run/beamOn 1000