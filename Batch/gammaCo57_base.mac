/vis/verbose 0
/tracking/verbose 0
/event/verbose 0
/run/verbose 0

/particle/verbose 0
/tracking/verbose 0

/setMaterial/detectionMedium lCF4

/setMaterial/mediumTemp 145 kelvin
/setMaterial/mediumPressure 10.3 bar

/setMaterial/mediumLY 4 keVLY
/setMaterial/mediumLY_VisFraction 0.5

/setDetector/myVerbosity 0

/setDetector/useCollimator true
/setDetector/GammaThetaMax 1.5

/setDetector/gammaSource Co57 

/setDetector/gammaHeight 5

/run/initialize
/analysis/setFileName ../Co57_ref0_paperWalls

/run/beamOn 1000000