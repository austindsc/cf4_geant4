/vis/verbose 0
/tracking/verbose 0
/event/verbose 0
/run/verbose 0

/process/em/verbose 0
/process/had/deex/verbose 0
/particle/verbose 0
/tracking/verbose 0

/setMaterial/detectionMedium lCF4

/setMaterial/mediumTemp 128 kelvin
/setMaterial/mediumPressure 10.7 bar

/setMaterial/mediumLY 5000.0 MeVLY
/setMaterial/mediumLY_VisFraction 0.9

/setDetector/myVerbosity 1

/setDetector/useCollimator true
/setDetector/GammaThetaMax 2.5

/setDetector/gammaSource Cs137 

/setDetector/gammaHeight -0.5

/run/initialize
#/analysis/setFileName Cs137_28

/run/beamOn 1000000