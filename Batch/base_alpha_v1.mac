/vis/verbose 0
/tracking/verbose 0
/event/verbose 0
/run/verbose 0

/process/em/verbose 0
/process/had/deex/verbose 0
/particle/verbose 0
/tracking/verbose 0

### Material Properties ###
/setMaterial/detectionMedium gCF4

#/setMaterial/mediumDensity 1.6047 g/cm3
#/setMaterial/mediumTemp 145 kelvin
#/setMaterial/mediumPressure 10.2 bar
#/setMaterial/mediumLY 1000.0 MeVLY

/setDetector/myVerbosity 1

/setDetector/alphaHeight 4.5

### Initialize kernel (build detector) ###
/run/initialize

/analysis/setFileName testOut.root

### no visualization ###
/run/beamOn 100