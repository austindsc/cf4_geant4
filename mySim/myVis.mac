## Purely for viewing (no physics here)

/vis/open OGL 600x600-0+0

## Verbosity ##
#/vis/verbose warnings
#/vis/verbose errors
/vis/verbose 0

/vis/viewer/set/autoRefresh false

## drawing detector ##
/vis/drawVolume
/vis/viewer/set/style surface
#/vis/viewer/set/style wireframe
#/vis/viewer/set/auxiliaryEdge true
/vis/geometry/set/forceWireframe World 0 1

#/vis/geometry/set/forceWireframe logic_mediumCyl 0 1
#/vis/geometry/set/forceWireframe logic_med_upperFlange 0 1
#/vis/geometry/set/forceWireframe logic_med_solidupperFlange 0 1
#/vis/geometry/set/forceWireframe logic_med_lowerFlange 0 1
#/vis/geometry/set/forceWireframe logic_outercan 0 1
/vis/geometry/set/colour logic_mediumCyl 1 0.33 0.33 0.33 0.5
/vis/geometry/set/colour logic_med_upperFlange 1 0.33 0.33 0.33 0.5
/vis/geometry/set/colour logic_med_solidupperFlange 1 0.33 0.33 0.33 0.5
/vis/geometry/set/colour logic_med_lowerFlange 1 0.33 0.33 0.33 0.5
/vis/geometry/set/colour logic_can1Plate 1 0.87 0.87 0.87 2
/vis/geometry/set/colour logic_can1 1 0.2 0.2 0.2 0.2
/vis/geometry/set/colour logic_can1_bottom 1 0.2 0.2 0.2 0.2
/vis/geometry/set/colour logic_outercan 1 0.2 0.2 0.2 0.2

## drawing the gammma stuff ##
/vis/geometry/set/forceWireframe logic_collWorld 0 1
/vis/geometry/set/colour logic_CF4 1 43 45 47 0.4
/vis/geometry/set/colour logic_b2 1 43 45 47 0.4
/vis/geometry/set/colour logic_b3 1 43 45 47 0.4
/vis/geometry/set/colour logic_b4 1 43 45 47 0.4
/vis/geometry/set/colour logic_gammaSource 1 1 0 0 1.
/vis/geometry/set/colour logic_plasticTube 1 0.96 0.42 0.26 0.5

## drawing the alpha source ##
/vis/geometry/set/forceWireframe logic_alphaWorld 0 1
/vis/geometry/set/colour logic_palladium 0 0 0 0 1
#/vis/geometry/set/colour logic_gold 0 255 215 0 1
#/vis/geometry/set/colour logic_amo2 0 255 0 0 1
#/vis/geometry/set/colour logic_Ag 0 .75 .75 .75 1

/vis/geometry/set/colour logic_medium 0 0 0 1 .1
#/vis/geometry/set/colour logic_sipm 0 0 0 0 1
/vis/geometry/set/colour logic_package 0 1 1 1 1
#/vis/geometry/set/colour logic_CaseSides 0 1 1 1 1

## trajectories ##
/vis/scene/add/trajectories smooth
#/vis/modeling/trajectories/create/drawByCharge
#/vis/modeling/trajectories/drawByCharge-0/default/setDrawStepPts true
#/vis/modeling/trajectories/drawByCharge-0/default/setStepPtsSize 2
# (if too many tracks cause core dump => /tracking/storeTrajectory 0)

/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set e- red
/vis/modeling/trajectories/drawByParticleID-0/set opticalphoton pink
/vis/modeling/trajectories/drawByParticleID-0/set gamma green
/vis/modeling/trajectories/drawByParticleID-0/set nu_e grey
/vis/modeling/trajectories/drawByParticleID-0/set anti_nu_e grey
/vis/modeling/trajectories/drawByParticleID-0/set alpha yellow
#/vis/modeling/trajectories/drawByParticleID-0/set GenericIon grey

## draw only alphas ##
#/vis/filtering/trajectories/create/particleFilter
#/vis/filtering/trajectories/particleFilter-0/add alpha

## axes
/vis/scene/add/axes 0 0 0 1 cm

## decorations ##
/vis/scene/add/arrow -19 -19 0 -19 -19 5 cm # along +z, 5cm long
/vis/scene/add/arrow -19 -19 0 -15 -19 0 cm # along +x, 5cm long
# both cause errors. scale will show. text wont
#/vis/scene/add/scale 10 cm z 10 10 10 auto 0 0 0 cm
#/vis/scene/add/text -11 -11 -26 cm .5 .25 .25 hello

/vis/viewer/set/upVector 0 0 1
/vis/viewer/set/viewpointThetaPhi 90 340

/vis/viewer/set/autoRefresh true

/vis/scene/endOfEventAction accumulate
#/vis/scene/endOfEventAction refresh
#/vis/scene/endOfRunAction refresh

/vis/ogl/set/displayListLimit 20000