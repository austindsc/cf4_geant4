# this produces 100 photons from a single random location on a disk

#/setDetector/myVerbosity 1

/gps/particle opticalphoton
/gps/pos/type Point

/gps/ene/mono 2.0 eV # want around 22-25%
#/gps/energy 2.48 eV # want around 35%
/gps/number 10

/gps/particle opticalphoton
/gps/pos/type Plane
/gps/pos/shape Circle

/gps/ang/type iso

# photons at SiPM
/gps/pos/centre 0.1 0.2 3.5 cm
#/gps/direction 0 0 -1

/analysis/setFileName LIVETEST
#/analysis/ntuple/setFileName 0 anotherNameIWant3

/run/beamOn 1