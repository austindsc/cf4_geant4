# this produces 100 photons from a single random location on a disk

/gps/particle opticalphoton
/gps/pos/type Point

/gps/ene/mono 6.2 eV # want around 22-25%
#/gps/energy 2.48 eV # want around 35%
/gps/number 1

# photons at SiPM
/gps/pos/centre 0.2 0.2 1.5 cm
/gps/direction 0 0 -1

#/analysis/setFileName photonTest2
#/analysis/ntuple/setFileName 0 anotherNameIWant3

/run/initialize

/run/beamOn 1