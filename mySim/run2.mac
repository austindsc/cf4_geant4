/vis/verbose 0
/tracking/verbose 0
/event/verbose 0
/run/verbose 0

/process/em/verbose 0
/process/had/verbose 0
/particle/verbose 0
/tracking/verbose 0

/setMaterial/detectionMedium lCF4

#/setMaterial/mediumTemp 128 kelvin
#/setMaterial/mediumPressure 10.7 bar

/setMaterial/mediumLY 0.1 keVLY
/setMaterial/mediumLY_VisFraction 0.7

### detector configuration ###
/setDetector/myVerbosity 0                # 1 outputs event level data

/setDetector/alphaHeight 0.5              # this sets alphaStatus to true, at height in cm. 4.5 is roughly max height possible (non-physical?)

### Initialize kernel (build detector) ###
/run/initialize

/analysis/setFileName alphaTest_liq

### no visualization ###
/run/beamOn 10000