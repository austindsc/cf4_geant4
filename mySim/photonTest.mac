# this produces many photons from all over a disk

/vis/verbose 0
/event/verbose 0
/run/verbose 0

#/process/em/verbose 0
#/process/had/deex/verbose 0
/particle/verbose 0
/tracking/verbose 0

#/setMaterial/detectionMedium lCF4
#/setMaterial/mediumTemp 128 kelvin        # this alone sets density based on saturation curve data (gas or liquid CF4)
#/setMaterial/mediumPressure 10.7 bar

#/setDetector/myVerbosity 1

/gps/particle opticalphoton
/gps/energy 2 eV
/gps/pos/type Plane
/gps/pos/shape Circle
/gps/pos/radius 5 mm
/gps/number 1000

/gps/pos/centre 0.0 0.0 2 cm
/gps/direction 0 0 -1

/analysis/setFileName photonTest2
#/analysis/ntuple/setFileName 0 anotherNameIWant3

#/run/initialize

/run/beamOn 100