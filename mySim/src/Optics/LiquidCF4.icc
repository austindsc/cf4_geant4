// helper file to do optics of Gas CF4.
// Same scope as in DetectorMaterials::BuildMaterials()

G4MaterialPropertiesTable *mpt_liquidCF4 = new G4MaterialPropertiesTable();
mLiquidCF4->SetMaterialPropertiesTable(mpt_liquidCF4);


//------- Refractive Indexes ------- //
// taken from literature with many different densities
// french paper (7, 5eV), other two from second paper
G4double liq_cf4_photonE[4] = {7*eV, 5*eV, 2*eV, 1*eV}; 
G4double liq_cf4_n[4] = {1.24, 1.225, 1.21, 1.2039};
mpt_liquidCF4->AddProperty("RINDEX", liq_cf4_photonE, liq_cf4_n, 4);

//------- Scintillation Components ------- //
// Take 5 Bar spectra from Morozov, split into UV and Vis region and scale their intensity independently
// loading in data
std::vector<G4double> wls_UV_5bar, intensity_UV_5bar;
OH::ReadAndFillArray("data/cf4Scint_5bar_UV.txt", wls_UV_5bar, intensity_UV_5bar, 0);

std::vector<G4double> wls_Vis_5bar, intensity_Vis_5bar;
OH::ReadAndFillArray("data/cf4Scint_5bar_Vis.txt", wls_Vis_5bar, intensity_Vis_5bar, 0);

// making the Ephoton arrays
int nUV = wls_UV_5bar.size();
G4double photonE_UV_5bar[nUV];
G4double rev_intensity_UV_5bar[nUV];

int nVis = wls_Vis_5bar.size();
G4double photonE_Vis_5bar[nVis];
G4double rev_intensity_Vis_5bar[nVis];

// flipping wavelengths to photon energy, and reversing intensities as well
for (size_t i = 0; i < nUV; i++){
  photonE_UV_5bar[nUV - i - 1] = CLHEP::h_Planck * CLHEP::c_light/ (wls_UV_5bar[i] * nm);
  rev_intensity_UV_5bar[nUV - i -1] = intensity_UV_5bar[i];
  // G4cout << CLHEP::h_Planck * CLHEP::c_light/ (wls_UV_5bar[i] * nm) / eV << " eV" << G4endl;
}
for (size_t i = 0; i < nVis; i++){
  photonE_Vis_5bar[nVis - i - 1] = CLHEP::h_Planck * CLHEP::c_light/ (wls_Vis_5bar[i] * nm);
  rev_intensity_Vis_5bar[nVis - i -1] = intensity_Vis_5bar[i];
}

// this isn't exactly correct... the Vis light should come after the UV light
G4double zRiseTime = 1.0*ns;
G4double zUVfallTime = 5.0*ns;
G4double zVisfallTime = 20.*ns;

// UV component
mpt_liquidCF4->AddProperty("SCINTILLATIONCOMPONENT1", photonE_UV_5bar , rev_intensity_UV_5bar, nUV);
mpt_liquidCF4->AddConstProperty("SCINTILLATIONTIMECONSTANT1", zUVfallTime); 
mpt_liquidCF4->AddConstProperty("SCINTILLATIONRISETIME1", zRiseTime);
mpt_liquidCF4->AddConstProperty("SCINTILLATIONYIELD1", cf4Liq_lyUV);
// Vis component
mpt_liquidCF4->AddProperty("SCINTILLATIONCOMPONENT2", photonE_Vis_5bar, rev_intensity_Vis_5bar, nVis);
mpt_liquidCF4->AddConstProperty("SCINTILLATIONTIMECONSTANT2", zVisfallTime); 
mpt_liquidCF4->AddConstProperty("SCINTILLATIONRISETIME2", zRiseTime);
mpt_liquidCF4->AddConstProperty("SCINTILLATIONYIELD2", cf4Liq_lyVis);

// Set total yield
mpt_liquidCF4->AddConstProperty("SCINTILLATIONYIELD", cf4Liq_ly);
mLiquidCF4->GetIonisation()->SetBirksConstant(0.0 * mm/MeV); // zero for now
// mLiquidCF4->GetIonisation()->SetBirksConstant(0.432 * mm/MeV); // guessed from other plastics
// HO::testHO();


// Things that shouldn't change
mpt_liquidCF4->AddConstProperty("RESOLUTIONSCALE", 1); 

