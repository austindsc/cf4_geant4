# Macro file for the initialization of example CF4
# in interactive session

## Verbosities ##

/vis/verbose 0
/tracking/verbose 0
/event/verbose 0
/run/verbose 0

#/run/numberOfThreads 1 # defaults to zero


/process/em/verbose 0
/process/had/verbose 0
/particle/verbose 0
/cuts/verbose 0

/tracking/verbose 0
/event/verbose 0
/run/verbose 0
/vis/verbose 0

### Material Properties ###
#/setMaterial/detectionMedium gCF4        # default is gas
#/setMaterial/detectionMedium gAr         # currently undefined
/setMaterial/detectionMedium lCF4         # see Optics/material for default LYs
#/setMaterial/detectionMedium vacuum

#/setMaterial/mediumDensity 1.69 g/cm3  # use this to set density directly. Takes precendece over density calculated by SetTemp. default densities given in DetectorMaterials.cc
/setMaterial/mediumTemp 128 kelvin        # this alone sets density based on saturation curve data (gas or liquid CF4)
/setMaterial/mediumPressure 10.7 bar      # If pressure also set, and sim is built with REFPROP (default), 
                                          # then REFPROP is used to calculate density with T, P for pure CF4

/setMaterial/mediumLY 1.0 keVLY        # these units are photons/MeV, keVLY also available
/setMaterial/mediumLY_VisFraction 0.8    # use this with total LY, or the two commands below
#/setMaterial/mediumLY_UV 0 MeVLY
#/setMaterial/mediumLY_Vis 5000 MeVLY

### detector configuration ###
/setDetector/myVerbosity 1                # 1 outputs event level data
                                          # 2 some photon level data, all data that is used
                                          # -1 means fill ntuple regardless (good for optical photon testing where eDep == 0)

#/setDetector/useLPFilter                 # just calling this makes it true, there is no argument

#/setDetector/useCollimator true           # default is true
#/setDetector/gammaHeight 4.0              # this turns on detConst.gammaStatus
#/setDetector/GammaThetaMax 1.0              # user-bias angle of non-iso gamma sources, default is 2degrees, see detectorconstruction()

#/setDetector/gammaSource Cs137            # default, see those available in detectorconstruction header and primary generator
#/setDetector/gammaSource Co60
#/setDetector/gammaSource Co57
#/setDetector/gammaSource isoCs137         # iso uses the built-in G4 gammas. This is energetically more correct but takes WAY longer to build statistics if using collimator (for obvious reasons)
#/setDetector/gammaSource isoCo60
#/setDetector/gammaSource isoCo57

/setDetector/alphaHeight 4.0             # this sets alphaStatus to true, at height in cm. 4.5 is roughly max height possible (non-physical?)
                                        # currently gamma and alpha source have same intensity (see primary generator constructor to change)

# or load anything you want here
#/control/execute ../mySim/livePhotonTest.mac

## process toggling (some outdated?) ##
#/process/optical/processActivation Scintillation false
#/process/optical/processActivation Cerenkov false
#/process/optical/processActivation OpRayleigh false
#/process/optical/processActivation OpAbsorption true
#/process/optical/processActivation OpBoundary true

#/process/optical/verbose 2
#/process/optical/scintillation/verbose 1

### Naming Output ###
/analysis/setFileName testNaming2                  # use either of these functions. whatever is last overrides
#/analysis/ntuple/setFileName 0 anotherNameIWant   # this doesn't work anymore bc ntuple is made in BeginRunAction

### Initialize kernel (build detector) ###
/run/initialize

### no visualization ###
/run/beamOn 1

### run visualization ###
/control/execute ../mySim/myVis.mac
#/control/exit
#/control/execute ../mySim/livePhotonTest.mac