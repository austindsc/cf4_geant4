{
    "configurations": [
        {
            "name": "Mac",
            "forcedInclude": [
                "${env:G4HOME}/include/Geant4/G4Types.hh",
                "${env:G4HOME}/include/Geant4/**"
            ],
            "includePath": [
                "${workspaceFolder}/**",
                "${env:G4HOME}/include/**"
            ],
            "defines": [],
            "macFrameworkPath": [
                "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks"
            ],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}